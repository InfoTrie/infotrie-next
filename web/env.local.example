# ============================================================
# Keycloak / NextAuth Configuration
# ============================================================

# Secret used to encrypt session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-here"

# Keycloak OIDC provider settings
KEYCLOAK_CLIENT_ID="infotrie-web"
KEYCLOAK_CLIENT_SECRET="your-client-secret-here"
KEYCLOAK_ISSUER="https://auth.infotrie.com/realms/infotrie"

# Base URL of the Next.js app (used by NextAuth for callback URLs)
AUTH_URL="https://infotrie.com"

# Trust the proxy headers (required when behind a reverse proxy / ingress)
AUTH_TRUST_HOST=true
